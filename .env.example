# Meridian environment variables (names only, placeholder values).
# Copy to .env for local use. .env is git-ignored and must never be committed.
# Every variable the project reads must be listed here (common criterion C6).
# The full environment and secrets matrix is defined in T03.

# --- Engine -----------------------------------------------------
# Postgres connection for the engine (T14)
MERIDIAN_DATABASE_URL=postgresql://meridian:change-me@meridian-postgres:5432/meridian
# Claude API key for the analyst review (T17)
ANTHROPIC_API_KEY=
# Model name for the analyst review (T17)
MERIDIAN_LLM_MODEL=

# --- Engine to Drupal publisher (T19) ---------------------------
MERIDIAN_DRUPAL_BASE_URL=https://meridian.ddev.site
MERIDIAN_DRUPAL_INGEST_CLIENT_ID=
MERIDIAN_DRUPAL_INGEST_CLIENT_SECRET=

# --- Next.js dashboard (T21, T22) -------------------------------
NEXT_PUBLIC_DRUPAL_BASE_URL=https://meridian.ddev.site
DRUPAL_READ_CLIENT_ID=
DRUPAL_READ_CLIENT_SECRET=
