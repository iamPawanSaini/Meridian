#!/usr/bin/env bash

## Description: Run every quality check (lint, types, tests, coverage gate, standards checks)
## Usage: quality
## Example: ddev quality
## Flags: []

# Thin wrapper: scripts/quality.sh is the only implementation (T04a).
# T05: component tools run inside DDEV by default, because the host PHP may be too old.
# An explicit QUALITY_RUNNER=native still wins.
export QUALITY_RUNNER="${QUALITY_RUNNER:-ddev}"
exec "$DDEV_APPROOT/scripts/quality.sh" "$@"
