# ---------------------------------------------------------------
# Meridian .gitignore
# ---------------------------------------------------------------

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key

# Engine records, database files and dumps
records/
*.db
*.sqlite
*.sqlite3
*.sql
*.sql.gz
*.dump
*.pgdump
*.tar.gz
db-dumps/

# Local tooling installed by scripts/bootstrap-dev.sh
.tools/

# Dependencies
node_modules/
vendor/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Next.js
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Test output
test-results/
playwright-report/
coverage/

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db

# Claude Code: per-user settings
.claude/settings.local.json

# ---------------------------------------------------------------
# Drupal (Composer root is apps/drupal, docroot is web/)
# ---------------------------------------------------------------
apps/drupal/web/core/
apps/drupal/web/modules/contrib/
apps/drupal/web/themes/contrib/
apps/drupal/web/profiles/contrib/
apps/drupal/web/libraries/
apps/drupal/web/sites/*/files/
apps/drupal/web/sites/*/private/
apps/drupal/web/sites/*/settings.local.php
apps/drupal/web/sites/*/services.local.yml
apps/drupal/web/sites/simpletest/
apps/drupal/drush/Commands/contrib/
apps/drupal/vendor/
apps/drupal/private/

# Generated by Composer scaffolding (core-composer-scaffold, drupal-integrations). Integrated
# Composer on Pantheon regenerates them (T05, KD-7). Owned paths stay tracked: composer.json,
# composer.lock, pantheon.yml, config/sync/, web/sites/default/settings.php, web/*/custom/.
apps/drupal/.editorconfig
apps/drupal/.gitattributes
apps/drupal/.gitignore
apps/drupal/recipes/README.txt
apps/drupal/recipes/.gitignore
apps/drupal/web/.csslintrc
apps/drupal/web/.eslintignore
apps/drupal/web/.eslintrc.json
apps/drupal/web/.gitignore
apps/drupal/web/.ht.router.php
apps/drupal/web/.htaccess
apps/drupal/web/INSTALL.txt
apps/drupal/web/README.md
apps/drupal/web/autoload.php
apps/drupal/web/autoload_runtime.php
apps/drupal/web/example.gitignore
apps/drupal/web/index.php
apps/drupal/web/robots.txt
apps/drupal/web/update.php
apps/drupal/web/web.config
apps/drupal/web/modules/.gitignore
apps/drupal/web/modules/README.txt
apps/drupal/web/profiles/.gitignore
apps/drupal/web/profiles/README.txt
apps/drupal/web/themes/.gitignore
apps/drupal/web/themes/README.txt
apps/drupal/web/sites/.gitignore
apps/drupal/web/sites/README.txt
apps/drupal/web/sites/development.services.yml
apps/drupal/web/sites/example.*
apps/drupal/web/sites/*/.gitignore
apps/drupal/web/sites/*/default.settings.php
apps/drupal/web/sites/*/default.services*.yml
apps/drupal/web/sites/*/settings.ddev.php
apps/drupal/web/sites/*/settings.pantheon.php
apps/drupal/web/sites/*/drushrc.php
