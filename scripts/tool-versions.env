# Pinned versions of the repository tooling that scripts/bootstrap-dev.sh installs.
# Change a version only in a task with a plan entry (dependency policy, T04a).
# Every SHA-256 below was copied from the publisher's checksum file or release digest on
# 2026-11-03 (T08), never typed from memory. Bootstrap fails on a mismatch.

# pre-commit zipapp pre-commit-${PRE_COMMIT_VERSION}.pyz. Released 2026-10-13.
# Source: the SHA-256 digest of the release asset, from
# https://api.github.com/repos/pre-commit/pre-commit/releases/tags/v4.7.0
# (release page: https://github.com/pre-commit/pre-commit/releases/tag/v4.7.0).
PRE_COMMIT_VERSION=4.7.0
PRE_COMMIT_SHA256=393488513aed286d7a5a978a1fe79b2f5a8802927242a2d241ff10c1a8e8c885

# gitleaks, Linux x64 tarball gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz. Released 2026-03-21.
# Keep GITLEAKS_VERSION equal to the gitleaks hook rev in .pre-commit-config.yaml.
# Source: https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_checksums.txt
GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb

# actionlint, Linux amd64 tarball actionlint_${ACTIONLINT_VERSION}_linux_amd64.tar.gz.
# Released 2026-03-30.
# Source: https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_checksums.txt
ACTIONLINT_VERSION=1.7.12
ACTIONLINT_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8

# ShellCheck, Linux x86_64 tarball shellcheck-v${SHELLCHECK_VERSION}.linux.x86_64.tar.gz.
# Released 2025-08-04. The docs suites (T04a) run `shellcheck` from PATH, and the runner image
# ships an older one (0.9.0) than the pre-commit hook (shellcheck-py 0.11.0.1), so CI uses this.
# Source: the SHA-256 digest of the release asset, from
# https://api.github.com/repos/koalaman/shellcheck/releases/tags/v0.11.0
# (release page: https://github.com/koalaman/shellcheck/releases/tag/v0.11.0).
SHELLCHECK_VERSION=0.11.0
SHELLCHECK_SHA256=b7af85e41cc99489dcc21d66c6d5f3685138f06d34651e6d34b42ec6d54fe6f6
